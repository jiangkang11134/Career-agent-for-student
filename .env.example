# Smart Agent local configuration.
# Copy this file to .env and fill in only the provider you use.

# Domain is selected explicitly with --domain code or --domain career.

# Optional Root Supervisor. Modes: off, auto, force.
# auto bypasses simple tasks; force supervises every task. The legacy
# SMART_AGENT_ORCHESTRATOR=p-e-rp value remains supported as force.
# SMART_AGENT_SUPERVISOR=auto
# SMART_AGENT_SUPERVISOR_MODEL=optional-supervisor-planner-model
# SMART_AGENT_SUPERVISOR_MAX_REPLANS=1

# OpenAI-compatible API (Doubao, DeepSeek, Qwen, vLLM, etc.).
# CUSTOM_API_BASE_URL=https://your-api-endpoint/v1
# CUSTOM_API_KEY=your-api-key-here
# CUSTOM_MODEL=your-model-name

# Career structured generation. Fact extraction, JD analysis, and interview
# question generation may explicitly fall back to this OpenAI-compatible API.
# Doubao Ark uses an endpoint ID as the model value.
# CAREER_GENERATION_PROVIDER=doubao
# CAREER_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_GENERATION_API_KEY=your-ark-api-key
# CAREER_GENERATION_MODEL=your-doubao-endpoint-id
# CAREER_MODEL_TIMEOUT_SECONDS=90
# CAREER_MODEL_MAX_RETRIES=2
# CAREER_GENERATION_INPUT_PRICE_PER_MILLION=0
# CAREER_GENERATION_OUTPUT_PRICE_PER_MILLION=0

# Optional role-specific overrides. A configured role requires provider, base
# URL, API key, and model together.
# CAREER_FACT_EXTRACTOR_PROVIDER=doubao
# CAREER_FACT_EXTRACTOR_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_FACT_EXTRACTOR_API_KEY=your-ark-api-key
# CAREER_FACT_EXTRACTOR_MODEL=your-fact-extractor-endpoint-id
# CAREER_JD_ANALYZER_PROVIDER=doubao
# CAREER_JD_ANALYZER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_JD_ANALYZER_API_KEY=your-ark-api-key
# CAREER_JD_ANALYZER_MODEL=your-jd-analyzer-endpoint-id
# CAREER_INTERVIEW_QUESTION_PROVIDER=doubao
# CAREER_INTERVIEW_QUESTION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_INTERVIEW_QUESTION_API_KEY=your-ark-api-key
# CAREER_INTERVIEW_QUESTION_MODEL=your-question-endpoint-id

# Interview evaluation never falls back to CAREER_GENERATION_*; configure an
# independent model/API identity to avoid self-review.
# CAREER_INTERVIEW_EVALUATOR_PROVIDER=openai
# CAREER_INTERVIEW_EVALUATOR_BASE_URL=https://api.openai.com/v1
# CAREER_INTERVIEW_EVALUATOR_API_KEY=your-independent-key
# CAREER_INTERVIEW_EVALUATOR_MODEL=gpt-4o-mini
# CAREER_INTERVIEW_EVALUATOR_INPUT_PRICE_PER_MILLION=0
# CAREER_INTERVIEW_EVALUATOR_OUTPUT_PRICE_PER_MILLION=0

# Career semantic retrieval (Doubao Ark/OpenAI-compatible embeddings).
# Vector backend: qdrant (recommended for deployment) or chromadb (local legacy).
# CAREER_VECTOR_BACKEND=qdrant
# CAREER_VECTOR_STORE=qdrant
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_TIMEOUT_SECONDS=10
# QDRANT_COLLECTION_PREFIX=smart_agent_project
# Optional shared services for the deployment profile.
# SMART_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# SMART_AGENT_DATABASE_URL=mysql+pymysql://smart_agent:smart-agent-dev@127.0.0.1:13306/smart_agent
# SMART_AGENT_FACT_LEDGER_BACKEND=mysql
# CAREER_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_EMBEDDING_API_KEY=your-ark-api-key
# CAREER_EMBEDDING_MODEL=your-embedding-endpoint-id
# CAREER_EMBEDDING_TIMEOUT_SECONDS=60
# CAREER_LOCAL_BGE_PYTHON=D:/RAG/environments/python/python.exe
# CAREER_LOCAL_BGE_MODEL=D:/RAG/models/BGE-M3
# CAREER_LOCAL_BGE_RERANKER_MODEL=D:/RAG/models/bge-reranker-base
# CAREER_LOCAL_BGE_DEVICE=cuda:0
# CAREER_INTERVIEW_RETRIEVAL_VARIANT=hybrid_rrf_rerank
# CAREER_INTERVIEW_LIVE_RETRIEVAL_VARIANT=hybrid_rrf
# CAREER_INTERVIEW_RRF_K=60
# CAREER_INTERVIEW_NEIGHBOR_WINDOW=1
# CAREER_INTERVIEW_RERANK_CANDIDATE_LIMIT=30

# Project deep-scan gate. Existing personal evidence is always matched first.
# CAREER_PROJECT_SEARCH_HIGH_THRESHOLD=0.65
# CAREER_PROJECT_SEARCH_MEDIUM_THRESHOLD=0.40
# CAREER_PROJECT_SUFFICIENT_EVIDENCE_SCORE=0.72
# CAREER_PROJECT_SEARCH_MAX_CANDIDATES=3
# CAREER_PROJECT_DEEP_SCAN_BUDGET=3

# Optional reranker for the hybrid interview knowledge retriever. Without it,
# the offline authority/topic reranker remains available as an ablation baseline.
# CAREER_RERANKER_PROVIDER=doubao
# CAREER_RERANKER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CAREER_RERANKER_API_KEY=your-ark-api-key
# CAREER_RERANKER_MODEL=your-reranker-endpoint-id
# CAREER_RERANKER_TIMEOUT_SECONDS=60
# CAREER_RERANKER_MAX_RETRIES=2
# CAREER_RERANKER_INPUT_PRICE_PER_MILLION=0

# Career RAGAS evaluation Judge and optional answer-quality embeddings.
# These are runtime-only evaluation settings; never commit real API keys.
# EVALUATION_JUDGE_PROVIDER=custom
# EVALUATION_JUDGE_MODEL=gpt-5.6-sol
# EVALUATION_JUDGE_BASE_URL=https://your-api-endpoint/v1
# EVALUATION_JUDGE_API_KEY=runtime-secret
# EVALUATION_EMBEDDING_PROVIDER=custom
# EVALUATION_EMBEDDING_MODEL=text-embedding-3-small
# EVALUATION_EMBEDDING_BASE_URL=https://your-api-endpoint/v1
# EVALUATION_EMBEDDING_API_KEY=runtime-secret

# Independent Resume Verification Agent. This must use a different model AND
# a different API endpoint from the resume generation model.
# CAREER_VERIFIER_PROVIDER=openai
# CAREER_VERIFIER_BASE_URL=https://api.openai.com
# CAREER_VERIFIER_API_KEY=your-second-provider-key
# CAREER_VERIFIER_MODEL=gpt-4o-mini

# Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Review: off, loose, or strict.
SMART_AGENT_REVIEW_MODE=strict
# SMART_AGENT_REVIEW_SUB_MODEL=

# Maximum API cost per run in USD.
SMART_AGENT_API_COST_LIMIT=0.50

# Optional image OCR. Text/Markdown material import is offline-capable.
SMART_AGENT_OCR_PROVIDER=text
SMART_AGENT_OCR_LANGUAGE=eng

# Optional real voice providers. The gateway contracts are documented in
# smart_agent/career/voice.py. TTS voice/style are provider-specific.
# SMART_AGENT_ASR_BASE_URL=https://your-asr-gateway
# SMART_AGENT_ASR_API_KEY=your-asr-key
# SMART_AGENT_ASR_MODEL=your-asr-model
# SMART_AGENT_TTS_BASE_URL=https://your-tts-gateway
# SMART_AGENT_TTS_API_KEY=your-tts-key
# SMART_AGENT_TTS_MODEL=your-tts-model
# SMART_AGENT_TTS_VOICE=your-natural-voice-id
# SMART_AGENT_TTS_STYLE=calm-interviewer
# SMART_AGENT_TTS_TIMEOUT_SECONDS=30
# SMART_AGENT_TTS_MAX_RETRIES=1
# SMART_AGENT_TTS_RETRY_BACKOFF_SECONDS=0.1

# Recommended production Mandarin TTS: official Volcengine / Doubao OpenSpeech.
# SMART_AGENT_TTS_PROVIDER=official
# SMART_AGENT_VOLCENGINE_TTS_APP_ID=your-volcengine-app-id
# SMART_AGENT_TTS_API_KEY=your-volcengine-access-token
# SMART_AGENT_TTS_VOICE=zh_female_qingxin
# SMART_AGENT_VOLCENGINE_TTS_ENCODING=mp3
# SMART_AGENT_VOLCENGINE_TTS_SPEED_RATIO=1.0

# Experimental local CosyVoice. Keep it as a fallback unless latency is proven.
# SMART_AGENT_TTS_PROVIDER=cosyvoice
# SMART_AGENT_TTS_BASE_URL=http://127.0.0.1:9881
# SMART_AGENT_TTS_MODEL=cosyvoice3-0.5b

# GPT-SoVITS v2 API. Start api_v2.py separately in a CUDA environment.
# The reference path is resolved by the GPT-SoVITS process, not Smart Agent.
# SMART_AGENT_TTS_PROVIDER=gpt-sovits
# SMART_AGENT_TTS_BASE_URL=http://127.0.0.1:9880
# SMART_AGENT_GPT_SOVITS_REF_AUDIO_PATH=D:/voices/interviewer.wav
# SMART_AGENT_GPT_SOVITS_PROMPT_TEXT=参考音频中实际说出的完整文字
# SMART_AGENT_GPT_SOVITS_PROMPT_LANG=zh
# SMART_AGENT_GPT_SOVITS_TEXT_LANG=zh
# SMART_AGENT_GPT_SOVITS_SPEED_FACTOR=1.0

# Docker Desktop must be running to use sandbox_test.
